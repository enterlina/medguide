# Server-only Nebius Token Factory configuration. Never expose these as NEXT_PUBLIC_*.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL_ID=

# Server-only FastAPI review service. Never use NEXT_PUBLIC_* for reviewer tokens.
MEDGUIDE_EVIDENCE_API_URL=http://127.0.0.1:8000

# Local development only. Never enable in production.
MEDGUIDE_REVIEW_DEV_BYPASS=false

